{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AlzaProducts (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AlzaProducts/bin/Debug/net10.0/AlzaProducts.dll",
      "cwd": "${workspaceFolder}/src/AlzaProducts",
      "launchSettingsProfile": "http",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
