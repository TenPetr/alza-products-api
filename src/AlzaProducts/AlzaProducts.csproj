<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Title and description of the OpenAPI (Swagger) documents, one document per API version -->
    <AssemblyTitle>Alza Products API</AssemblyTitle>
    <Description>Products of an e-shop, with a partial update of a single product</Description>
    <!-- XML doc comments feed the OpenAPI (Swagger) documentation; not every public member or parameter needs one -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- Local secrets such as the database password live outside the repository: dotnet user-secrets set ... -->
    <UserSecretsId>525a487e-7324-4ac5-9f04-4916905c2098</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

</Project>
